# DeepSeek AI 配置（AI 功能必需）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 服务端口
PORT=3001

# JWT 密钥（生产环境请修改为随机字符串）
JWT_SECRET=change-me-in-production

# 管理员初始密码
ADMIN_PASSWORD=admin123

# 微信支付配置（可选）
WXPAY_ENABLED=false
WXPAY_MCH_ID=
WXPAY_APP_ID=
WXPAY_APP_SECRET=
WXPAY_API_V3_KEY=
WXPAY_SERIAL_NO=
WXPAY_KEY_PATH=
WXPAY_NOTIFY_URL=
